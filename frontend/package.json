{
  "name": "gexbot-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:runtime": "tsc --module commonjs --moduleResolution node --target ES2022 --esModuleInterop --skipLibCheck --strict --outDir /tmp/gexbot-frontend-runtime tests/*-runtime.test.ts && for test_file in /tmp/gexbot-frontend-runtime/tests/*-runtime.test.js; do node \"$test_file\"; done"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
