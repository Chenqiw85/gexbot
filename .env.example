# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# GEXBOT_PROVIDER: "mock" for local development, "tradier" for real data.
GEXBOT_PROVIDER=mock
# Tradier REST base URL. Production: https://api.tradier.com/v1
# Sandbox:               https://sandbox.tradier.com/v1
TRADIER_BASE_URL=https://api.tradier.com/v1
# REQUIRED when GEXBOT_PROVIDER=tradier. Never commit a real token.
TRADIER_TOKEN=

# ---------------------------------------------------------------------------
# Application defaults
# ---------------------------------------------------------------------------
GEXBOT_TICKERS=SPY,QQQ
DEFAULT_RISK_FREE_RATE=0.05
DEFAULT_DIVIDEND_YIELD=0.0
DEFAULT_MIN_DTE=0
DEFAULT_MAX_DTE=45
DEFAULT_MAX_EXPIRATIONS=12
CHAIN_REFRESH_SECONDS=900
SPOT_REFRESH_SECONDS=15
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# In Docker the schema is loaded by Postgres init SQL, so the app keeps this false.
AUTO_ENSURE_SCHEMA=true

# ---------------------------------------------------------------------------
# Database connection pool (self-hosted defaults)
# ---------------------------------------------------------------------------
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Security / exposure (single-user, private self-hosting)
# ---------------------------------------------------------------------------
# Host interface the API/web ports bind to. Default 127.0.0.1 keeps the stack
# private to this machine. Change deliberately (see README) for LAN/VPN access.
GEXBOT_BIND_HOST=127.0.0.1
# Optional API key. When UNSET (default), localhost usage needs no auth.
# When SET, mutating endpoints (POST/PATCH/PUT/DELETE) require an X-API-Key
# header. NOTE: the bundled browser frontend does not send this key, so setting
# it is intended for reverse-proxy / API-only deployments (see README).
GEXBOT_API_KEY=
